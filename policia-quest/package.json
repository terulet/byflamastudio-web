{
  "name": "policia-quest",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Policia Quest — Preparació Policia Local · Roses. PWA d'estudi local-first.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc -b --force",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test accessibility",
    "content:validate": "tsx scripts/validate-content.ts",
    "content:report": "tsx scripts/report-coverage.ts",
    "sources:download": "tsx scripts/download-sources.ts",
    "sources:extract": "tsx scripts/extract-sources.ts",
    "exams:import": "tsx scripts/import-roses-exams.ts",
    "check": "npm run typecheck && npm run content:validate && npm run test && npm run build"
  },
  "dependencies": {
    "idb": "^8.0.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "axe-core": "^4.13.0",
    "jsdom": "^30.0.1",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.11"
  }
}
